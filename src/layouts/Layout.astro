---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  favicon?: string;
  ogImage?: string;
}

const {
  title = 'Ateliér Karczech | Architektura & Projekce',
  description = 'Ateliér Karczech – architektonický ateliér. Navrhujeme v BIMu, od prvního náčrtu po realizaci.',
  favicon = '/favicon.svg',
  ogImage = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://atelierkarczech.cz');
const ogImageUrl = ogImage ? new URL(ogImage, canonical).href : '';
---

<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <link rel="icon" href={favicon} />
    <link rel="apple-touch-icon" href={favicon} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    <!-- Fonts are self-hosted (see global.css); these two faces carry the -->
    <!-- first screen, so they are fetched in parallel with the stylesheet. -->
    <link
      rel="preload"
      href="/fonts/josefin-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body class="bg-brand-950 text-white font-sans antialiased overflow-x-hidden">
    <slot />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
