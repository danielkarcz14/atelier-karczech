---
import SectionTitle from './SectionTitle.astro';

interface Render {
  title: string;
  image: string;
  imageFull: string;
  alt?: string;
}

interface Stat {
  value: string;
  suffix?: string;
  label: string;
}

interface Heading {
  eyebrow?: string;
  titlePlain?: string;
  titleAccent?: string;
  titleLayout?: string;
  description?: string;
  stats?: Stat[];
}

interface Props {
  renders?: Render[];
  heading: Heading;
}

const { renders = [], heading } = Astro.props;
const stats = heading.stats ?? [];

// A stat that is nothing but digits counts up on scroll; anything else
// (3D, LOD, …) is rendered as-is.
const isCountable = (value: string) => /^\d+$/.test(value.trim());
---

<section id="bim" class="py-24 md:py-36 relative overflow-hidden">
  <div class="absolute top-0 right-0 w-1/2 h-full bg-accent/[0.03] rounded-l-[4rem] hidden lg:block"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-12 relative">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div class="reveal">
        <SectionTitle
          eyebrow={heading.eyebrow}
          plain={heading.titlePlain}
          accent={heading.titleAccent}
          layout={heading.titleLayout}
          headingClass="font-serif text-4xl md:text-6xl font-bold leading-tight mb-6"
        />
        {
          heading.description && (
            <p class="text-brand-300 text-lg font-light leading-relaxed mb-10 max-w-md">{heading.description}</p>
          )
        }
        {
          stats.length > 0 && (
            <div class="grid grid-cols-3 gap-8">
              {stats.map((stat) => (
                <div>
                  {isCountable(stat.value) ? (
                    <div
                      class="counter text-4xl font-serif font-bold text-accent"
                      data-target={stat.value.trim()}
                      data-suffix={stat.suffix ?? ''}
                    >
                      0{stat.suffix}
                    </div>
                  ) : (
                    <div class="text-4xl font-serif font-bold text-accent">
                      {stat.value}
                      {stat.suffix}
                    </div>
                  )}
                  <div class="text-[11px] tracking-[0.2em] uppercase text-brand-500 mt-2">{stat.label}</div>
                </div>
              ))}
            </div>
          )
        }
      </div>

      <div class="reveal reveal-delay-2">
        {
          renders.length > 0 ? (
            <div class="bim-slider rounded-3xl overflow-hidden border border-brand-800/50 aspect-[4/3]" id="bimSlider">
              <div class="bim-track" id="bimTrack">
                {renders.map((r) => (
                  <button type="button" class="bim-slide" data-full={r.imageFull} aria-label="Zvětšit vizualizaci">
                    <img src={r.image} alt={r.alt ?? r.title} loading="lazy" decoding="async" />
                  </button>
                ))}
              </div>

              <button type="button" class="portfolio-arrow prev" id="bimPrev" aria-label="Předchozí vizualizace">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
                </svg>
              </button>
              <button type="button" class="portfolio-arrow next" id="bimNext" aria-label="Další vizualizace">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
                </svg>
              </button>

              <div class="bim-dots" id="bimDots">
                {renders.map((_, i) => (
                  <span class="bim-dot" data-index={i} />
                ))}
              </div>
            </div>
          ) : (
            <div class="bg-brand-900/50 border border-brand-800/50 rounded-3xl aspect-[4/3] flex items-center justify-center relative overflow-hidden group">
              <div class="absolute inset-0 bg-gradient-to-br from-accent/5 to-transparent" />
              <div class="relative text-center p-12">
                <div class="w-20 h-20 mx-auto rounded-full border border-accent/20 flex items-center justify-center mb-6">
                  <svg class="w-8 h-8 text-accent/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                  </svg>
                </div>
                <p class="text-brand-400 font-serif text-lg">BIM vizualizace</p>
                <p class="text-brand-600 text-sm mt-2 font-light">Brzy doplníme</p>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
