---
import SectionTitle from './SectionTitle.astro';

interface Render {
  title: string;
  image: string;
  imageFull: string;
  alt?: string;
}

interface Stat {
  prefix?: string;
  value: string;
  suffix?: string;
  label: string;
}

interface Heading {
  index?: string;
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
  description?: string;
  stats?: Stat[];
}

interface Props {
  renders?: Render[];
  heading: Heading;
}

const { renders = [], heading } = Astro.props;
const stats = heading.stats ?? [];

// A stat that is nothing but digits counts up on scroll; anything else
// (3D, LOD, …) is rendered as-is.
const isCountable = (value: string) => /^\d+$/.test(value.trim());
---

<section id="bim" class="py-24 md:py-36">
  <div class="page-shell">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-start">
      <div class="reveal lg:sticky lg:top-32">
        <SectionTitle index={heading.index} eyebrow={heading.eyebrow} title={heading.title} titleAccent={heading.titleAccent} />
        {
          heading.description && (
            <p class="text-brand-300 text-lg font-light leading-relaxed max-w-md mt-8">{heading.description}</p>
          )
        }
        {
          stats.length > 0 && (
            <dl class="flex flex-wrap gap-x-10 gap-y-8 mt-12 border-t border-brand-800/40 pt-8">
              {stats.map((stat) => (
                <div>
                  <dt class="sr-only">{stat.label}</dt>
                  <dd>
                    <div class="font-display text-3xl md:text-4xl font-bold text-accent tracking-tight flex items-baseline gap-1.5 whitespace-nowrap">
                      {/* Same size as the figure; the lighter weight keeps the number leading. */}
                      {stat.prefix && <span class="font-medium">{stat.prefix}</span>}
                      {isCountable(stat.value) ? (
                        <span
                          class="counter tabular-nums"
                          data-target={stat.value.trim()}
                          data-suffix={stat.suffix ?? ''}
                        >
                          0{stat.suffix}
                        </span>
                      ) : (
                        <span>
                          {stat.value}
                          {stat.suffix}
                        </span>
                      )}
                    </div>
                    <div class="text-xs text-brand-500 mt-2 leading-snug">{stat.label}</div>
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>

      <div class="reveal reveal-delay-1">
        {
          renders.length > 0 ? (
            <div class="bim-slider overflow-hidden rounded-[2px] aspect-[4/3]" id="bimSlider">
              <div class="bim-track" id="bimTrack">
                {renders.map((r) => (
                  <button type="button" class="bim-slide" data-full={r.imageFull} aria-label="Zvětšit vizualizaci">
                    <img src={r.image} alt={r.alt ?? r.title} loading="lazy" decoding="async" />
                  </button>
                ))}
              </div>

              <button type="button" class="portfolio-arrow prev" id="bimPrev" aria-label="Předchozí vizualizace">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
                </svg>
              </button>
              <button type="button" class="portfolio-arrow next" id="bimNext" aria-label="Další vizualizace">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
                </svg>
              </button>

              <div class="bim-dots" id="bimDots">
                {renders.map((_, i) => (
                  <span class="bim-dot" data-index={i} />
                ))}
              </div>
            </div>
          ) : (
            <div class="border border-brand-800/50 rounded-[2px] aspect-[4/3] flex items-center justify-center">
              <div class="text-center p-12">
                <p class="text-brand-400 font-display text-lg font-medium">BIM vizualizace</p>
                <p class="text-brand-600 text-sm mt-2 font-light">Brzy doplníme</p>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
