---
import SectionTitle from './SectionTitle.astro';

interface Heading {
  index?: string;
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
  formTitle?: string;
  submitLabel?: string;
}

interface Props {
  heading: Heading;
  contactPerson: string;
  phone: string;
  phoneHref: string;
  email: string;
  addressLine1?: string;
  addressLine2?: string;
  showMap?: boolean;
  mapLat?: string;
  mapLon?: string;
}

const {
  heading,
  contactPerson,
  phone,
  phoneHref,
  email,
  addressLine1,
  addressLine2,
  showMap = true,
  mapLat,
  mapLon,
} = Astro.props;

const lat = Number(mapLat);
const lon = Number(mapLon);
const hasCoords = Number.isFinite(lat) && Number.isFinite(lon) && (lat !== 0 || lon !== 0);
const address = [addressLine1, addressLine2].filter(Boolean).join(', ');

// OpenStreetMap needs a bounding box for the embed. The band is wide and
// short, so the box is stretched horizontally to match its proportions.
const mapLink = hasCoords
  ? `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=17/${lat}/${lon}`
  : '';
const mapEmbed = hasCoords
  ? `https://www.openstreetmap.org/export/embed.html?bbox=${lon - 0.012}%2C${lat - 0.0025}%2C${lon + 0.012}%2C${lat + 0.0025}&layer=mapnik&marker=${lat}%2C${lon}`
  : '';

const rows = [
  { label: 'Kontaktní osoba', value: contactPerson, href: '' },
  { label: 'Telefon', value: phone, href: phoneHref ? `tel:${phoneHref}` : '' },
  { label: 'E-mail', value: email, href: email ? `mailto:${email}` : '' },
].filter((row) => row.value);
---

<section id="kontakt" class="pt-24 md:pt-36">
  <div class="page-shell">
    <div class="reveal">
      <SectionTitle
        index={heading.index}
        eyebrow={heading.eyebrow}
        title={heading.title}
        titleAccent={heading.titleAccent}
      />
    </div>

    <div class="grid lg:grid-cols-2 gap-x-16 gap-y-14 mt-16">
      <div class="reveal">
        {/* Same rhythm as the form beside it: small label on top, content
            below, hairline underneath, identical spacing. */}
        <h3 class="font-display text-xl font-bold tracking-tight mb-8">Kde nás najdete</h3>
        <dl class="space-y-7">
          {
            rows.map((row) => (
              <div class="pb-3 border-b border-brand-800/40">
                <dt class="text-xs text-brand-600 mb-2">{row.label}</dt>
                <dd class="text-lg break-words">
                  {row.href ? (
                    <a href={row.href} class="hover:text-accent transition-colors">
                      {row.value}
                    </a>
                  ) : (
                    row.value
                  )}
                </dd>
              </div>
            ))
          }
          {
            address && (
              <div class="pb-3 border-b border-brand-800/40">
                <dt class="text-xs text-brand-600 mb-2">Adresa</dt>
                <dd class="text-lg leading-snug">
                  {hasCoords ? (
                    <a href={mapLink} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
                      {addressLine1}
                      <br />
                      {addressLine2}
                    </a>
                  ) : (
                    <>
                      {addressLine1}
                      <br />
                      {addressLine2}
                    </>
                  )}
                </dd>
              </div>
            )
          }
        </dl>
      </div>

      <div class="reveal reveal-delay-1">
        <h3 class="font-display text-xl font-bold tracking-tight mb-8">{heading.formTitle}</h3>
        <form id="contactForm" action="/.netlify/functions/contact" method="POST" class="space-y-7" novalidate>
          <!-- Honeypot: hidden field (display:none) that humans never fill in, but bots do. -->
          <div class="hp-field" aria-hidden="true">
            <label for="_gotcha">Nevyplňovat</label>
            <input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>
          <div>
            <label for="name" class="block text-xs text-brand-600 mb-2">Jméno a příjmení</label>
            <input type="text" id="name" name="name" required class="form-input w-full py-3 text-white placeholder-brand-700" placeholder="Jan Novák" />
          </div>
          <div>
            <label for="email" class="block text-xs text-brand-600 mb-2">E-mail</label>
            <input type="email" id="email" name="email" required class="form-input w-full py-3 text-white placeholder-brand-700" placeholder="jan@email.cz" />
          </div>
          <div>
            <label for="phone" class="block text-xs text-brand-600 mb-2">Telefon</label>
            <input type="tel" id="phone" name="phone" class="form-input w-full py-3 text-white placeholder-brand-700" placeholder="+420 ..." />
          </div>
          <div>
            <label for="message" class="block text-xs text-brand-600 mb-2">Zpráva</label>
            <textarea id="message" name="message" rows="4" required class="form-input w-full py-3 text-white placeholder-brand-700 resize-none" placeholder="Popište váš záměr..."></textarea>
          </div>
          <button type="submit" class="btn-primary bg-accent text-brand-950 px-8 py-4 rounded-[2px] font-semibold text-sm tracking-wide hover:text-brand-950 transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
            {heading.submitLabel}
          </button>
          <p id="formStatus" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>

  {
    showMap && hasCoords && (
      /* Full-bleed band closing the page, the way the CTA strip above it
         runs edge to edge. A map this wide is finally usable as a map. */
      <div class="map-band mt-24 md:mt-32 border-t border-brand-800/40">
        {/* The src is attached by main.js once the band scrolls close: the
            embed measures itself once on load, and a lazy iframe can load
            before the full-width band has its final size — which left the
            map rendered into a corner of it. Loading it late also means
            OpenStreetMap only hears from visitors who reach the map. */}
        <iframe
          data-src={mapEmbed}
          class="w-full h-full block"
          style="border:0"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Mapa – ${address}`}
        />
      </div>
    )
  }
</section>
