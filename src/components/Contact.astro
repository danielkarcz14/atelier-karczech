---
import SectionTitle from './SectionTitle.astro';

interface Heading {
  index?: string;
  eyebrow?: string;
  title?: string;
  formTitle?: string;
  submitLabel?: string;
}

interface Props {
  heading: Heading;
  contactPerson: string;
  phone: string;
  phoneHref: string;
  email: string;
  addressLine1?: string;
  addressLine2?: string;
  showMap?: boolean;
  mapLat?: string;
  mapLon?: string;
}

const {
  heading,
  contactPerson,
  phone,
  phoneHref,
  email,
  addressLine1,
  addressLine2,
  showMap = true,
  mapLat,
  mapLon,
} = Astro.props;

const lat = Number(mapLat);
const lon = Number(mapLon);
const hasCoords = Number.isFinite(lat) && Number.isFinite(lon) && (lat !== 0 || lon !== 0);
const address = [addressLine1, addressLine2].filter(Boolean).join(', ');

// OpenStreetMap needs a bounding box for the embed; a ±0.003° / ±0.006° box
// around the marker is roughly a street-level view.
const mapLink = hasCoords
  ? `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=18/${lat}/${lon}`
  : '';
const mapEmbed = hasCoords
  ? `https://www.openstreetmap.org/export/embed.html?bbox=${lon - 0.006}%2C${lat - 0.003}%2C${lon + 0.006}%2C${lat + 0.003}&layer=mapnik&marker=${lat}%2C${lon}`
  : '';
---

<section id="kontakt" class="py-24 md:py-36">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24">
      <div class="reveal">
        <SectionTitle index={heading.index} eyebrow={heading.eyebrow} title={heading.title} />

        <dl class="mt-12">
          {
            contactPerson && (
              <div class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-4 py-5 border-t border-brand-800/40">
                <dt class="text-xs text-brand-600 pt-1">Kontaktní osoba</dt>
                <dd class="text-lg">{contactPerson}</dd>
              </div>
            )
          }
          {
            phone && (
              <div class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-4 py-5 border-t border-brand-800/40">
                <dt class="text-xs text-brand-600 pt-1">Telefon</dt>
                <dd class="text-lg">
                  <a href={`tel:${phoneHref}`} class="hover:text-accent transition-colors">
                    {phone}
                  </a>
                </dd>
              </div>
            )
          }
          {
            email && (
              <div class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-4 py-5 border-t border-brand-800/40">
                <dt class="text-xs text-brand-600 pt-1">E-mail</dt>
                <dd class="text-lg break-words">
                  <a href={`mailto:${email}`} class="hover:text-accent transition-colors">
                    {email}
                  </a>
                </dd>
              </div>
            )
          }
          {
            address && (
              <div class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-4 py-5 border-y border-brand-800/40">
                <dt class="text-xs text-brand-600 pt-1">Adresa</dt>
                <dd class="text-lg leading-snug">
                  {hasCoords ? (
                    <a href={mapLink} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
                      {addressLine1}
                      <br />
                      {addressLine2}
                    </a>
                  ) : (
                    <>
                      {addressLine1}
                      <br />
                      {addressLine2}
                    </>
                  )}
                </dd>
              </div>
            )
          }
        </dl>

        {
          showMap && hasCoords && (
            <div class="mt-10 overflow-hidden rounded-[2px] border border-brand-800/40 aspect-[16/10]">
              <iframe
                src={mapEmbed}
                class="w-full h-full"
                style="border:0"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title={`Mapa – ${address}`}
              />
            </div>
          )
        }
      </div>

      <div class="reveal reveal-delay-1 lg:pt-20">
        <h3 class="font-serif text-2xl font-semibold tracking-tight mb-8">{heading.formTitle}</h3>
        <form id="contactForm" action="/.netlify/functions/contact" method="POST" class="space-y-6" novalidate>
          <!-- Honeypot: hidden field (display:none) that humans never fill in, but bots do. -->
          <div class="hp-field" aria-hidden="true">
            <label for="_gotcha">Nevyplňovat</label>
            <input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>
          <div>
            <label for="name" class="block text-xs text-brand-600 mb-2">Jméno a příjmení</label>
            <input type="text" id="name" name="name" required class="form-input w-full px-4 py-3.5 rounded-[2px] text-white placeholder-brand-700" placeholder="Jan Novák" />
          </div>
          <div>
            <label for="email" class="block text-xs text-brand-600 mb-2">E-mail</label>
            <input type="email" id="email" name="email" required class="form-input w-full px-4 py-3.5 rounded-[2px] text-white placeholder-brand-700" placeholder="jan@email.cz" />
          </div>
          <div>
            <label for="phone" class="block text-xs text-brand-600 mb-2">Telefon</label>
            <input type="tel" id="phone" name="phone" class="form-input w-full px-4 py-3.5 rounded-[2px] text-white placeholder-brand-700" placeholder="+420 ..." />
          </div>
          <div>
            <label for="message" class="block text-xs text-brand-600 mb-2">Zpráva</label>
            <textarea id="message" name="message" rows="5" required class="form-input w-full px-4 py-3.5 rounded-[2px] text-white placeholder-brand-700 resize-none" placeholder="Popište váš záměr..."></textarea>
          </div>
          <button type="submit" class="btn-primary w-full bg-accent text-brand-950 py-4 rounded-[2px] font-medium text-sm tracking-wide uppercase hover:text-brand-950 transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
            {heading.submitLabel}
          </button>
          <p id="formStatus" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>
