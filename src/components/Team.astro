---
import { Image } from 'astro:assets';
import SectionTitle from './SectionTitle.astro';

interface Member {
  name: string;
  role: string;
  photo?: ImageMetadata | null;
}

interface Heading {
  index?: string;
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
}

interface Props {
  members: Member[];
  heading: Heading;
}

const { members, heading } = Astro.props;

function initials(name: string) {
  return name
    .replace(/^Bc\.?\s*/i, '')
    .split(/\s+/)
    .map((w) => w[0])
    .filter(Boolean)
    .slice(0, 2)
    .join('')
    .toUpperCase();
}
---

<section id="tym" class="py-24 md:py-36">
  <div class="page-shell">
    <div class="reveal mb-16">
      <SectionTitle index={heading.index} eyebrow={heading.eyebrow} title={heading.title} titleAccent={heading.titleAccent} />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-14" id="teamGrid">
      {
        members.map((m) => (
          <div class="team-card reveal">
            <div class="aspect-[3/4] overflow-hidden bg-brand-900 rounded-[2px] relative">
              {m.photo ? (
                <Image
                  src={m.photo}
                  alt={m.name}
                  widths={[400, 600, 900]}
                  sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 90vw"
                  class="team-img w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center text-accent text-5xl font-display font-bold">
                  {initials(m.name)}
                </div>
              )}
            </div>
            <div class="border-t border-brand-800/40 mt-5 pt-4">
              <h3 class="font-display text-xl font-bold tracking-tight">{m.name}</h3>
              <p class="text-brand-500 text-sm mt-1 font-light">{m.role}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
