---
// Section header used across the page: a short accent rule with a small
// index/label row, then the headline. The optional accent part drops to its
// own line in the brand colour. Newlines in the CMS title become line breaks.
interface Props {
  index?: string;
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
  meta?: string;
  headingClass?: string;
  align?: string;
}

const {
  index = '',
  eyebrow = '',
  title = '',
  titleAccent = '',
  meta = '',
  headingClass = 'section-title',
  align = 'left',
} = Astro.props;

const lines = title.split('\n').filter((line) => line !== '');
const hasLabel = Boolean(index || eyebrow || meta);
---

{
  hasLabel && (
    <div class:list={['section-label', align === 'center' && 'section-label--center']}>
      <span class="section-label-left">
        <span class="section-dash" aria-hidden="true" />
        {index && <span class="section-index">{index}</span>}
        {eyebrow}
      </span>
      {meta && <span class="section-label-meta">{meta}</span>}
    </div>
  )
}

<h2 class={headingClass}>
  {
    lines.map((line, i) => (
      <>
        {i > 0 && <br />}
        {line}
      </>
    ))
  }{titleAccent && <br />}{titleAccent && <span class="text-accent">{titleAccent}</span>}
</h2>
