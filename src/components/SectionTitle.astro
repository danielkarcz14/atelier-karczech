---
// Section header used across the page: a hairline rule, a quiet index/label
// row beneath it, and the headline itself. Newlines in the CMS title become
// line breaks. No italic accent here — that device is reserved for the hero.
interface Props {
  index?: string;
  eyebrow?: string;
  title?: string;
  meta?: string;
  headingClass?: string;
  align?: string;
  rule?: boolean;
}

const {
  index = '',
  eyebrow = '',
  title = '',
  meta = '',
  headingClass = 'section-title',
  align = 'left',
  rule = true,
} = Astro.props;

const lines = title.split('\n').filter((line) => line !== '');
const hasLabel = Boolean(index || eyebrow || meta);
---

{rule && hasLabel && <div class="section-rule"></div>}

{
  hasLabel && (
    <div class:list={['section-label', align === 'center' && 'section-label--center']}>
      <span class="section-label-left">
        {index && <span class="section-index">{index}</span>}
        {eyebrow}
      </span>
      {meta && <span class="section-label-meta">{meta}</span>}
    </div>
  )
}

<h2 class={headingClass}>
  {
    lines.map((line, i) => (
      <>
        {i > 0 && <br />}
        {line}
      </>
    ))
  }
</h2>
