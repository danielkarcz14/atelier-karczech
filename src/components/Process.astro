---
import SectionTitle from './SectionTitle.astro';

interface Step {
  number: string;
  title: string;
  body: string;
}

interface Heading {
  index?: string;
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

interface Props {
  steps: Step[];
  heading: Heading;
}

const { steps, heading } = Astro.props;
---

<section id="proces" class="py-24 md:py-36">
  <div class="page-shell">
    <div class="reveal">
      <SectionTitle
        index={heading.index}
        eyebrow={heading.eyebrow}
        title={heading.title}
        titleAccent={heading.titleAccent}
      />
      {
        heading.description && (
          <p class="text-brand-400 font-light leading-relaxed max-w-xl mt-8">{heading.description}</p>
        )
      }
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12 mt-16">
      {
        steps.map((step) => (
          <div class="flow-step step-card">
            <span class="flow-number">{step.number}</span>
            <h3 class="font-display text-xl font-bold tracking-tight mb-3">{step.title}</h3>
            <p class="text-brand-400 text-sm font-light leading-relaxed">{step.body}</p>
          </div>
        ))
      }
    </div>

    {
      heading.ctaLabel && (
        <a
          href={heading.ctaHref}
          class="btn-primary inline-block bg-accent text-brand-950 px-8 py-4 rounded-[2px] font-semibold text-sm tracking-wide mt-16 hover:text-brand-950 transition-colors"
        >
          {heading.ctaLabel}
        </a>
      )
    }
  </div>
</section>
