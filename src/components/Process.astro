---
import SectionTitle from './SectionTitle.astro';

interface Step {
  number: string;
  title: string;
  body: string;
}

interface Heading {
  index?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

interface Props {
  steps: Step[];
  heading: Heading;
}

const { steps, heading } = Astro.props;
---

<section id="proces" class="py-24 md:py-36">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <div class="reveal">
          <SectionTitle index={heading.index} eyebrow={heading.eyebrow} title={heading.title} />
          {
            heading.description && (
              <p class="text-brand-400 font-light leading-relaxed max-w-md mt-8">{heading.description}</p>
            )
          }
          {
            heading.ctaLabel && (
              <a
                href={heading.ctaHref}
                class="btn-primary inline-block bg-accent text-brand-950 px-8 py-4 rounded-[2px] font-medium text-sm tracking-wide uppercase mt-10 hover:text-brand-950 transition-colors"
              >
                {heading.ctaLabel}
              </a>
            )
          }
        </div>
      </div>

      <div>
        {
          steps.map((step, i) => (
            <div class="step-card relative grid grid-cols-[3.5rem_1fr] gap-6 py-8 border-t border-brand-800/40">
              <span class="step-number font-serif text-lg font-medium text-accent pt-1">{step.number}</span>
              <div>
                <h3 class="font-serif text-2xl font-semibold tracking-tight mb-3">{step.title}</h3>
                <p class="text-brand-400 font-light leading-relaxed">{step.body}</p>
              </div>
              {i === steps.length - 1 && <div class="absolute inset-x-0 -bottom-px h-px bg-brand-800/40" />}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
