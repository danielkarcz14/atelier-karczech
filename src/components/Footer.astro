---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  logoPlain: string;
  logoAccent: string;
  links: NavLink[];
  copyright: string;
}

const { logoPlain, logoAccent, links, copyright } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-brand-800/30">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 py-12">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      <a href="#" class="font-serif text-xl font-bold text-white">
        {logoPlain}<span class="text-accent">{logoAccent}</span>
      </a>
      <div class="flex flex-wrap justify-center gap-8">
        {
          links.map((link) => (
            <a href={link.href} class="nav-link text-sm text-brand-500 hover:text-white transition-colors">
              {link.label}
            </a>
          ))
        }
      </div>
      <div class="text-xs text-brand-600">
        &copy; {year} {copyright}
      </div>
    </div>
  </div>
</footer>
