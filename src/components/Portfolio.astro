---
import SectionTitle from './SectionTitle.astro';

interface Item {
  title: string;
  category: string;
  location?: string;
  year?: string;
  image: string;
  imageFull: string;
  alt?: string;
}

interface Heading {
  index?: string;
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
  description?: string;
}

interface Props {
  items: Item[];
  heading: Heading;
}

const { items, heading } = Astro.props;

// Czech declension for the project counter in the section label.
const countLabel = (n: number) => {
  if (n === 1) return '1 projekt';
  if (n >= 2 && n <= 4) return `${n} projekty`;
  return `${n} projektů`;
};

// The filter is built from whatever categories the CMS entries actually use.
const categories = [...new Set(items.map((item) => item.category).filter(Boolean))];

// Place and year are optional, so the line collapses to whatever is filled in.
const meta = (item: Item) => [item.category, item.location, item.year].filter(Boolean).join(' · ');
---

<section id="portfolio" class="py-24 md:py-36">
  <div class="page-shell">
    <div class="reveal">
      <SectionTitle
        index={heading.index}
        eyebrow={heading.eyebrow}
        title={heading.title}
        titleAccent={heading.titleAccent}
        meta={items.length > 0 ? countLabel(items.length) : ''}
      />
      {
        heading.description && (
          <p class="text-brand-400 text-sm md:text-base max-w-md font-light leading-relaxed mt-8">
            {heading.description}
          </p>
        )
      }
    </div>

    {
      categories.length > 1 && (
        <div
          class="flex flex-wrap gap-x-6 gap-y-3 mt-12 pb-5 border-b border-brand-800/40"
          id="portfolioFilter"
          role="group"
          aria-label="Filtrovat projekty podle kategorie"
        >
          <button type="button" class="filter-chip is-active" data-filter="">
            Vše
          </button>
          {categories.map((category) => (
            <button type="button" class="filter-chip" data-filter={category}>
              {category}
            </button>
          ))}
        </div>
      )
    }

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-14 mt-12" id="portfolioGrid">
      {
        items.map((item, i) => (
          <button
            type="button"
            class="portfolio-card group text-left cursor-pointer"
            data-full={item.imageFull}
            data-category={item.category}
            aria-label={`Zvětšit projekt ${item.title}`}
          >
            <div class="aspect-[4/3] overflow-hidden bg-brand-900">
              <img
                src={item.image}
                alt={item.alt ?? item.title}
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="flex items-baseline gap-3 mt-4">
              <span class="text-brand-600 text-xs tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="font-sans text-base md:text-lg font-bold text-white tracking-tight group-hover:text-accent transition-colors">
                {item.title}
              </h3>
            </div>
            <p class="text-brand-500 text-sm font-light mt-1 pl-8">{meta(item)}</p>
          </button>
        ))
      }
    </div>
  </div>
</section>
