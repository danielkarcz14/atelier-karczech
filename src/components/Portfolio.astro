---
import SectionTitle from './SectionTitle.astro';

interface Item {
  title: string;
  category: string;
  image: string;
  imageFull: string;
  alt?: string;
}

interface Heading {
  index?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  dragHint?: string;
}

interface Props {
  items: Item[];
  heading: Heading;
}

const { items, heading } = Astro.props;

// Czech declension for the project counter in the section label.
const countLabel = (n: number) => {
  if (n === 1) return '1 projekt';
  if (n >= 2 && n <= 4) return `${n} projekty`;
  return `${n} projektů`;
};
---

<section id="portfolio" class="py-24 md:py-36">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="reveal">
      <SectionTitle
        index={heading.index}
        eyebrow={heading.eyebrow}
        title={heading.title}
        meta={items.length > 0 ? countLabel(items.length) : ''}
      />
      {
        heading.description && (
          <p class="text-brand-400 text-sm md:text-base max-w-md font-light leading-relaxed mt-8">
            {heading.description}
          </p>
        )
      }
    </div>
  </div>

  <div class="portfolio-wrapper mt-16">
    <button type="button" id="portfolioPrev" class="portfolio-arrow prev is-hidden" aria-label="Předchozí projekty">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>

    <button type="button" id="portfolioNext" class="portfolio-arrow next" aria-label="Další projekty">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <div class="portfolio-track" id="portfolioTrack">
      {
        items.map((item, i) => (
          <div class="portfolio-card w-[85vw] md:w-[55vw] lg:w-[40vw] cursor-pointer" data-full={item.imageFull}>
            <div class="aspect-[16/10] overflow-hidden rounded-[2px]">
              <img
                src={item.image}
                alt={item.alt ?? item.title}
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="grid grid-cols-[2.5rem_1fr] gap-4 pt-5">
              <span class="text-brand-600 text-xs tabular-nums pt-2">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="font-serif text-xl md:text-2xl font-semibold text-white tracking-tight">{item.title}</h3>
                <p class="text-brand-500 text-sm mt-1 font-light">{item.category}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  {
    heading.dragHint && (
      <div class="max-w-7xl mx-auto px-6 lg:px-12 mt-12 flex items-center gap-4">
        <div class="h-px flex-1 bg-brand-800/40" />
        <span class="text-xs text-brand-600">{heading.dragHint}</span>
        <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </div>
    )
  }
</section>
