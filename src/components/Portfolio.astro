---
import SectionTitle from './SectionTitle.astro';

interface Item {
  title: string;
  category: string;
  image: string;
  imageFull: string;
  alt?: string;
}

interface Heading {
  index?: string;
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
  description?: string;
}

interface Props {
  items: Item[];
  heading: Heading;
}

const { items, heading } = Astro.props;

// Czech declension for the project counter in the section label.
const countLabel = (n: number) => {
  if (n === 1) return '1 projekt';
  if (n >= 2 && n <= 4) return `${n} projekty`;
  return `${n} projektů`;
};
---

<section id="portfolio" class="py-24 md:py-36">
  <div class="page-shell">
    <div class="reveal">
      <SectionTitle
        index={heading.index}
        eyebrow={heading.eyebrow}
        title={heading.title}
        titleAccent={heading.titleAccent}
        meta={items.length > 0 ? countLabel(items.length) : ''}
      />
      {
        heading.description && (
          <p class="text-brand-400 text-sm md:text-base max-w-md font-light leading-relaxed mt-8">
            {heading.description}
          </p>
        )
      }
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12 mt-16">
      {
        items.map((item, i) => (
          <button
            type="button"
            class="portfolio-card group text-left cursor-pointer"
            data-full={item.imageFull}
            aria-label={`Zvětšit projekt ${item.title}`}
          >
            <div class="aspect-[4/3] overflow-hidden rounded-[2px] bg-brand-900">
              <img
                src={item.image}
                alt={item.alt ?? item.title}
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="grid grid-cols-[2rem_1fr] gap-3 border-t border-brand-800/40 mt-4 pt-4">
              <span class="text-brand-600 text-xs tabular-nums pt-1.5">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="font-sans text-base md:text-lg font-bold text-white tracking-tight group-hover:text-accent transition-colors">
                  {item.title}
                </h3>
                <p class="text-brand-500 text-sm mt-1 font-light">{item.category}</p>
              </div>
            </div>
          </button>
        ))
      }
    </div>
  </div>
</section>
