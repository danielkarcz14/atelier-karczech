---
interface Props {
  titlePlain: string;
  titleAccent: string;
  subtitle: string;
  image: string;
  imageAlt: string;
  primaryCtaLabel: string;
  primaryCtaHref: string;
  secondaryCtaLabel: string;
  secondaryCtaHref: string;
}

const {
  titlePlain,
  titleAccent,
  subtitle,
  image,
  imageAlt,
  primaryCtaLabel,
  primaryCtaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
} = Astro.props;
---

<section class="relative min-h-screen flex items-center overflow-hidden pt-20">
  <div class="absolute inset-0">
    <img
      src={image}
      alt={imageAlt}
      class="parallax-hero w-full h-[120%] object-cover object-center"
      id="heroImg"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-overlay absolute inset-0"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 w-full">
    <div class="max-w-3xl">
      <h1 class="hero-title font-serif text-[2.75rem] sm:text-6xl md:text-7xl lg:text-8xl font-semibold leading-[0.96] tracking-[-0.03em] mb-8">
        <span>{titlePlain}&nbsp;</span><span class="italic text-accent">{titleAccent}</span>
      </h1>
      <div class="hero-line h-px bg-accent mb-8"></div>
      <p class="hero-fade text-brand-300 text-lg md:text-xl leading-relaxed max-w-xl font-light">
        {subtitle}
      </p>
      <div class="hero-cta flex flex-col sm:flex-row gap-4 mt-10">
        {
          primaryCtaLabel && (
            <a
              href={primaryCtaHref}
              class="btn-primary bg-accent text-brand-950 px-8 py-4 rounded-[2px] font-medium text-center text-sm tracking-wide uppercase hover:text-brand-950 transition-colors"
            >
              {primaryCtaLabel}
            </a>
          )
        }
        {
          secondaryCtaLabel && (
            <a
              href={secondaryCtaHref}
              class="btn-outline text-white px-8 py-4 rounded-[2px] font-light text-center text-sm tracking-wide uppercase hover:text-accent transition-colors"
            >
              {secondaryCtaLabel}
            </a>
          )
        }
      </div>
    </div>
  </div>

  <div class="hero-scroll absolute bottom-8 right-6 lg:right-12 hidden md:flex flex-col items-center gap-3">
    <span class="text-[10px] tracking-[0.3em] uppercase text-brand-400 rotate-90 origin-center translate-x-4 mb-8">Scroll</span>
    <div class="scroll-arrow w-px h-12 bg-gradient-to-b from-accent to-transparent"></div>
  </div>
</section>
