---
interface Props {
  badge?: string;
  titlePlain: string;
  titleAccent: string;
  subtitle: string;
  image: string;
  imageAlt: string;
  primaryCtaLabel: string;
  primaryCtaHref: string;
  secondaryCtaLabel: string;
  secondaryCtaHref: string;
}

const {
  badge = '',
  titlePlain,
  titleAccent,
  subtitle,
  image,
  imageAlt,
  primaryCtaLabel,
  primaryCtaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
} = Astro.props;
---

<section class="relative min-h-screen flex items-center overflow-hidden pt-20">
  <div class="absolute inset-0">
    <img
      src={image}
      alt={imageAlt}
      class="parallax-hero w-full h-[120%] object-cover object-center"
      id="heroImg"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-overlay absolute inset-0"></div>
  </div>

  <div class="page-shell relative z-10">
    <div class="max-w-3xl">
      {badge && <p class="hero-fade hero-badge mb-8">{badge}</p>}

      <h1 class="hero-title font-sans font-extrabold text-[2.5rem] sm:text-5xl md:text-6xl lg:text-7xl leading-[1.03] tracking-[-0.04em] mb-8">
        <span>{titlePlain}</span><br /><span class="text-accent">{titleAccent}</span>
      </h1>

      <p class="hero-fade text-brand-300 text-lg leading-relaxed max-w-md font-light">
        {subtitle}
      </p>

      <div class="hero-cta flex flex-col sm:flex-row gap-4 mt-10">
        {
          primaryCtaLabel && (
            <a
              href={primaryCtaHref}
              class="btn-primary bg-accent text-brand-950 px-8 py-4 rounded-[2px] font-semibold text-center text-sm tracking-wide hover:text-brand-950 transition-colors"
            >
              {primaryCtaLabel}
            </a>
          )
        }
        {
          secondaryCtaLabel && (
            <a
              href={secondaryCtaHref}
              class="btn-outline inline-flex items-center justify-center gap-2 text-white px-8 py-4 rounded-[2px] font-medium text-sm tracking-wide hover:text-accent transition-colors"
            >
              {secondaryCtaLabel}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </div>

  <div class="hero-scroll absolute bottom-8 right-6 lg:right-12 hidden md:flex flex-col items-center gap-3">
    <span class="text-[10px] tracking-[0.3em] uppercase text-brand-400 rotate-90 origin-center translate-x-4 mb-8">Scroll</span>
    <div class="scroll-arrow w-px h-12 bg-gradient-to-b from-accent to-transparent"></div>
  </div>
</section>
