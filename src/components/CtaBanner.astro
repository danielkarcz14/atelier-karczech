---
import SectionTitle from './SectionTitle.astro';

interface Props {
  title?: string;
  titleAccent?: string;
  text?: string;
  buttonLabel?: string;
  buttonHref?: string;
  image?: string;
}

const { title, titleAccent, text, buttonLabel, buttonHref, image = '/images/cta.webp' } = Astro.props;
---

<section class="relative overflow-hidden border-y border-brand-800/40">
  <div class="absolute inset-0">
    {image && <img src={image} alt="" class="w-full h-full object-cover opacity-15" loading="lazy" decoding="async" />}
    <div class="absolute inset-0 bg-gradient-to-r from-brand-950 via-brand-950/95 to-brand-950/75"></div>
  </div>

  <div class="page-shell relative py-24 md:py-32">
    <div class="grid lg:grid-cols-[1fr_auto] gap-10 lg:gap-16 items-end reveal">
      <div class="max-w-2xl">
        <SectionTitle title={title} titleAccent={titleAccent} />
        {text && <p class="text-brand-300 text-lg font-light leading-relaxed mt-6 max-w-lg">{text}</p>}
      </div>
      {
        buttonLabel && (
          <a
            href={buttonHref}
            class="btn-primary inline-block flex-shrink-0 bg-accent text-brand-950 px-10 py-5 rounded-[2px] font-medium text-sm tracking-wide uppercase hover:text-brand-950 transition-colors"
          >
            {buttonLabel}
          </a>
        )
      }
    </div>
  </div>
</section>
